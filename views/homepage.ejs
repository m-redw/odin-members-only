<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Homepage</title>
  </head>
  <body>
    <% if (locals.user) {%>
        <h1>Clubhouse Chat</h1>

        <!-- list messages here -->
        <% if (locals.messages) {%>
          <%messages.forEach((message)=> {%>
              <p><%= user.ismember ? message.author : "???"%></p>
              <p><%= user.ismember ? message.date : "???"%></p>
              <p><%= message.message %></p>
              <% if (user.isadmin) {%>
                <form action="/delete/:<%= message.id %>" method="POST">
                  <button type="submit">Delete</button>
                </form>
              <% } %>
          <% }) %>
        <% } %>

        <!-- Create message -->
        <form action="/create-message/<%= user.username %>" method="POST">
          <label for="message">Enter Message</label>
          <input id="message" name="message" type="text" />
          <button>Send</button>
        </form>

        <a href="/log-out">LOG OUT</a>

    <% } else { %>
        <h1>Log in to see messages!</h1>
        <form action="/log-in" method="POST">
            <label for="username">Username</label>
            <input id="username" name="username" placeholder="username" type="text" />
            <label for="password">Password</label>
            <input id="password" name="password" type="password" />
            <button type="submit">Log In</button>
        </form>
    <%}%>
  </body>
</html>
